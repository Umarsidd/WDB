# Frontend (Next.js); set at build time on Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_ORIGIN=http://127.0.0.1:4000
NEXT_PUBLIC_MAPS_EMBED_URL=
NEXT_PUBLIC_GA_ID=

# Backend (Express)
PORT=4000
MONGODB_URI=
# Local development only. Data is discarded when the API stops.
WDB_LOCAL_DB=1
MONGOMS_VERSION=8.0.17
# Uncomment on Ubuntu versions without a matching MongoDB package, such as 26.04.
# MONGOMS_DISTRO=ubuntu-24.04
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set only when requests reach the API through a known number of trusted proxy hops.
TRUST_PROXY_HOPS=
JWT_SECRET=
# Optional initial admin account; existing passwords are not overwritten.
ADMIN_EMAIL=
ADMIN_PASSWORD=
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
